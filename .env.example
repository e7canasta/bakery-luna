# Bakery Configuration
# ====================
# Copy this file to .env and adjust values as needed.
# All values shown are defaults.

# Directory for exported models (ONNX, OpenVINO IR)
# Structure: {BAKERY_MODELS_DIR}/{model_name}/{resolution}/{format}/
# Example:   models/yolo26n-seg/320/fp16/model.xml
BAKERY_MODELS_DIR=models

# Directory for calibration data (frames for INT8 quantization)
BAKERY_CALIBRATION_DIR=calibration_data

# Default YOLO version (8, 11, 26)
BAKERY_DEFAULT_YOLO=11

# ONNX opset version (17 recommended for OpenVINO compatibility)
BAKERY_ONNX_OPSET=17
